{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InstallEmbly",
  "version": "0.1.0",
  "identifier": "io.installembly.builder",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label":"main","title":"InstallEmbly","width":1180,"height":800,"minWidth":960,"minHeight":640}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {"active":false,"icon":["icons/icon.png","icons/icon.ico"]}
}
