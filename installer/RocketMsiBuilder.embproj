  <Installation directory="{ProgramFiles}\{ProductName}" existingFiles="default" allowDirectoryChange="true" />
  <Registry>
    <Entry id="item_1" root="HKCR" key="RocketMsiBuilder.embproj\shell\Open\Command" name="" type="REG_SZ" view="auto" uninstall="remove">
      <Data>"{InstallDestination}\RocketMsiBuilder.exe" "%1"</Data>
    </Entry>
    <Entry id="item_2" root="HKCR" key="RocketMsiBuilder.embproj\DefaultIcon" name="" type="REG_SZ" view="auto" uninstall="remove">
      <Data>"{InstallDestination}\RocketMsiBuilder.exe",0</Data>
    </Entry>
    <Entry id="item_3" root="HKCR" key=".embproj" name="" type="REG_SZ" view="auto" uninstall="remove">
      <Data>RocketMsiBuilder.embproj</Data>
    </Entry>
  </Registry>
  <Shortcuts>
    <Shortcut id="item_1" location="startMenu" name="Rocket MSI Builder" target="{InstallDestination}\RocketMsiBuilder.exe" workingDirectory="." description="">
      <Arguments />
    </Shortcut>
    <Shortcut id="item_2" location="desktop" name="Rocket MSI Builder" target="{InstallDestination}\RocketMsiBuilder.exe" workingDirectory="." description="">
      <Arguments />
    </Shortcut>
  </Shortcuts>
  <Upgrade enabled="true" />
  <UI mode="quick">
    <BrandingText>Rocket MSI</BrandingText>
    <FinishLaunch file="{InstallDestination}\RocketMsiBuilder.exe">
      <Arguments />
    </FinishLaunch>
  </UI>
  <Build outputDirectory="..\dist\installer" outputFile="RocketMSIBuilder-win64.msi">
    <Cabinet storage="embedded" split="none" />
  </Build>
</ExpressMsiBuilderProject>